# Copy to .env.local (never committed) and fill in the empty values.
# Generate the secrets with: npm run secrets:generate

# === APP ===
NODE_ENV=development
PORT=4100
APP_TIMEZONE=America/Sao_Paulo

# === DATABASE (Neon PostgreSQL) ===
# Use Neon's *pooled* connection string (host with "-pooler").
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.sa-east-1.aws.neon.tech/otto?sslmode=verify-full
DB_SSL=true
TYPEORM_LOGGING=false

# === SERVICE SECRETS ===
# Shared secret between the Otto clients (desktop app) and this API, sent in
# the X-Client-Api-Key header. Minimum 32 characters.
CLIENT_API_KEY=
# Sent by the scheduled GitHub Actions workflows as
# `Authorization: Bearer <CRON_SECRET>`. Empty = /internal/* is closed.
CRON_SECRET=

# === AUTH ===
# Generate the secrets with: npm run secrets:generate
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
# Days a device stays signed in without use.
REFRESH_TOKEN_TTL_DAYS=90
AUTH_HASH_SECRET=
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15

# === OWNER ACCOUNT ===
# There is no sign-up: the account is created on boot while the database has
# no user. Turn it off (and clear the password) once you can log in.
BOOTSTRAP_OWNER_ENABLED=false
BOOTSTRAP_OWNER_NAME=
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=

# === ASSISTANT (AI model) ===
# Key from https://aistudio.google.com/apikey (never commit it).
GEMINI_API_KEY=
# Model id; check the current free-tier models in Google AI Studio.
GEMINI_MODEL=gemini-3.5-flash-lite
# Previous messages sent to the model as context.
ASSISTANT_HISTORY_MESSAGES=12
ASSISTANT_MAX_TOOL_ROUNDS=4

# === AGENDA (Google Calendar via Apps Script) ===
# Install integrations/google-apps-script/otto-agenda.gs in your Google
# account (instructions at the top of the file). Empty = agenda off.
AGENDA_SCRIPT_URL=
AGENDA_SCRIPT_TOKEN=
