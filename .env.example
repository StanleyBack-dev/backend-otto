# Copy to .env.local (never committed) and fill in the empty values.
# Generate the secrets with: npm run secrets:generate

# === APP ===
NODE_ENV=development
PORT=4100
APP_TIMEZONE=America/Sao_Paulo

# === DATABASE (Neon PostgreSQL) ===
# Use Neon's *pooled* connection string (host with "-pooler").
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.sa-east-1.aws.neon.tech/otto?sslmode=verify-full
DB_SSL=true
TYPEORM_LOGGING=false

# === SERVICE SECRETS ===
# Shared secret between the Otto clients (desktop app) and this API, sent in
# the X-Client-Api-Key header. Minimum 32 characters.
CLIENT_API_KEY=
# Sent by the scheduled GitHub Actions workflows as
# `Authorization: Bearer <CRON_SECRET>`. Empty = /internal/* is closed.
CRON_SECRET=
